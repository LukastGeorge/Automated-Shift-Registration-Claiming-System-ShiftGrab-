# Copy to .env.prod on the server (chmod 600) and fill in. Never commit the real file.

# Public address of the site, without a trailing slash; DOMAIN is its host name (used for the TLS certificate).
DOMAIN=shiftgrab.example.com
SHIFTGRAB_PUBLIC_URL=https://shiftgrab.example.com

# Images to run: a released version (e.g. 0.7.0) or a commit SHA. CD sets this when it deploys.
IMAGE_PREFIX=ghcr.io/lukastgeorge
SHIFTGRAB_VERSION=0.7.0

# Generate each secret with: openssl rand -base64 32
DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Demo accounts shown in the README (manager / staff1 / staff2)
DEMO_MANAGER_PASSWORD=change-me
DEMO_STAFF_PASSWORD=change-me

# Outgoing e-mail. Defaults deliver to the internal Mailpit; set a real SMTP relay to send to people.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=ShiftGrab <no-reply@shiftgrab.example.com>

# Published ports of the edge proxy
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
