# Copy to .env (git-ignored) and adjust. Defaults below are for LOCAL DEVELOPMENT ONLY.
DB_NAME=shiftgrab
DB_USER=shiftgrab
DB_PASSWORD=shiftgrab
# Host port. Not 5432, so it never collides with a PostgreSQL installed natively on the developer machine.
DB_PORT=5433

REDIS_PORT=6379

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
