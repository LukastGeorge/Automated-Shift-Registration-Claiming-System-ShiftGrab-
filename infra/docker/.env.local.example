# Run the full production stack on your own machine (README "Quick start"). Demo values only: never use this file
# on a server. For a real deployment start from .env.prod.example instead.
DOMAIN=localhost
SHIFTGRAB_PUBLIC_URL=http://localhost:8088
IMAGE_PREFIX=local
SHIFTGRAB_VERSION=dev

DB_PASSWORD=local-db-password
KEYCLOAK_DB_PASSWORD=local-keycloak-db-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin
GRAFANA_ADMIN_PASSWORD=local-grafana-admin
GRAFANA_ANONYMOUS=true

# Demo accounts: manager / manager123, staff1 and staff2 / staff123
DEMO_MANAGER_PASSWORD=manager123
DEMO_STAFF_PASSWORD=staff123

BACKUP_DIR=backups
EDGE_HTTP_PORT=8088
EDGE_HTTPS_PORT=8443
